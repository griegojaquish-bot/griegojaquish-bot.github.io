1:["$","main",null,{"className":"article enArticle","children":[["$","header",null,{"className":"detailTop","children":[["$","$L6",null,{"className":"brand","href":"/en","children":[["$","b",null,{"children":"SJ"}],["$","span",null,{"children":["SHANJIANG",["$","small",null,{"children":"MODULAR HOUSING"}]]}]]}],["$","div",null,{"children":[["$","$L6",null,{"href":"/en/news","children":"Back to news"}],["$","a",null,{"className":"detailCta","href":"/en/#contact","children":"Get a quote →"}]]}]]}],["$","section",null,{"className":"articleHero","children":[["$","small",null,{"children":["Industry Knowledge","　·　","Jul 16, 2026"]}],["$","h1",null,{"children":"Integrated Buildings vs. Prefabricated Buildings: What Is the Difference?"}],["$","p",null,{"children":"In project discussions, integrated buildings and prefabricated buildings are often used interchangeably. Both rely on industrialised construction, but they differ in completion level, site work and relocation flexibility."}]]}],["$","div",null,{"className":"articleBody","children":[["$","aside",null,{"children":[["$","span",null,{"children":"CONTENTS"}],[["$","a","The key difference: completion level",{"href":"#section-1","children":["0",1,"　","The key difference: completion level"]}],["$","a","How should you choose?",{"href":"#section-2","children":["0",2,"　","How should you choose?"]}],["$","a","Delivery matters as much as the product",{"href":"#section-3","children":["0",3,"　","Delivery matters as much as the product"]}]]]}],["$","article",null,{"children":[[["$","section","The key difference: completion level",{"id":"section-1","children":[["$","h2",null,{"children":"The key difference: completion level"}],[["$","p","Integrated buildings are usually delivered as relatively complete space modules. Frames, envelopes, doors, windows and part of the building services can be prepared in the factory, leaving lifting, connection and commissioning on site.",{"children":"Integrated buildings are usually delivered as relatively complete space modules. Frames, envelopes, doors, windows and part of the building services can be prepared in the factory, leaving lifting, connection and commissioning on site."}],["$","p","Prefabricated building is a broader construction approach. It may use prefabricated walls, floors, beams and columns assembled on site, with more site processes for some permanent-building applications.",{"children":"Prefabricated building is a broader construction approach. It may use prefabricated walls, floors, beams and columns assembled on site, with more site processes for some permanent-building applications."}]]]}],["$","section","How should you choose?",{"id":"section-2","children":[["$","h2",null,{"children":"How should you choose?"}],[["$","p","If the project values fast installation, phased use, future relocation or reuse, flat-pack containers and quick-assembly houses are often a practical fit.",{"children":"If the project values fast installation, phased use, future relocation or reuse, flat-pack containers and quick-assembly houses are often a practical fit."}],["$","p","For long-term buildings with stricter requirements on structure, scale or local approvals, the design, permitting and construction conditions should be reviewed together.",{"children":"For long-term buildings with stricter requirements on structure, scale or local approvals, the design, permitting and construction conditions should be reviewed together."}]]]}],["$","section","Delivery matters as much as the product",{"id":"section-3","children":[["$","h2",null,{"children":"Delivery matters as much as the product"}],[["$","p","Site conditions, occupancy, water supply, drainage, electricity, fire safety and transport access all affect the final solution. Confirming these points early usually saves more time than changing the plan later.",{"children":"Site conditions, occupancy, water supply, drainage, electricity, fire safety and transport access all affect the final solution. Confirming these points early usually saves more time than changing the plan later."}]]]}]],"$L7"]}]]}],"$L8","$L9"]}]
