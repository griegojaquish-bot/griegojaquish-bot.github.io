1:["$","main",null,{"className":"article enArticle","children":[["$","header",null,{"className":"detailTop","children":[["$","$L6",null,{"className":"brand","href":"/en","children":[["$","b",null,{"children":"SJ"}],["$","span",null,{"children":["SHANJIANG",["$","small",null,{"children":"MODULAR HOUSING"}]]}]]}],["$","div",null,{"children":[["$","$L6",null,{"href":"/en/news","children":"Back to news"}],["$","a",null,{"className":"detailCta","href":"/en/#contact","children":"Get a quote →"}]]}]]}],["$","section",null,{"className":"articleHero","children":[["$","small",null,{"children":["Installation Guide","　·　","Jul 29, 2026"]}],["$","h1",null,{"children":"How Long Does a Quick-Assembly House Take to Install?"}],["$","p",null,{"children":"Quick-assembly houses can form a usable temporary space quickly, but the schedule depends on the site and construction organisation being ready first."}]]}],["$","div",null,{"className":"articleBody","children":[["$","aside",null,{"children":[["$","span",null,{"children":"CONTENTS"}],[["$","a","What affects the installation period?",{"href":"#section-1","children":["0",1,"　","What affects the installation period?"]}],["$","a","What should the site prepare?",{"href":"#section-2","children":["0",2,"　","What should the site prepare?"]}],["$","a","What should be checked after installation?",{"href":"#section-3","children":["0",3,"　","What should be checked after installation?"]}]]]}],["$","article",null,{"children":[[["$","section","What affects the installation period?",{"id":"section-1","children":[["$","h2",null,{"children":"What affects the installation period?"}],[["$","p","Quantity, floors, layout complexity, weather, lifting conditions and service works all affect the actual schedule. Standardised units are usually easier to organise at scale.",{"children":"Quantity, floors, layout complexity, weather, lifting conditions and service works all affect the actual schedule. Standardised units are usually easier to organise at scale."}]]]}],["$","section","What should the site prepare?",{"id":"section-2","children":[["$","h2",null,{"children":"What should the site prepare?"}],[["$","p","The site needs transport and lifting access. Foundations or support surfaces should be level and reliable, and water, power, drainage and earthing points should match the approved plan.",{"children":"The site needs transport and lifting access. Foundations or support surfaces should be level and reliable, and water, power, drainage and earthing points should match the approved plan."}]]]}],["$","section","What should be checked after installation?",{"id":"section-3","children":[["$","h2",null,{"children":"What should be checked after installation?"}],[["$","p","Inspect structural connections, roof waterproofing, door and window operation, electrical safety and drainage falls before the space is put into use. Plan routine maintenance afterward.",{"children":"Inspect structural connections, roof waterproofing, door and window operation, electrical safety and drainage falls before the space is put into use. Plan routine maintenance afterward."}]]]}]],["$","div",null,{"className":"articleCallout","children":[["$","b",null,{"children":"Need a project-specific recommendation?"}],["$","p",null,{"children":"Tell us your location, occupancy, schedule and intended use. The Shanjiang team can suggest a suitable product and space solution."}],["$","a",null,{"href":"/en/#contact","children":"Request project advice →"}]]}]]}]]}],["$","section",null,{"className":"related","children":[["$","p",null,{"className":"kicker","children":"RELATED"}],["$","h2",null,{"children":"Related content"}],["$","div",null,{"children":[["$","a","Quick Assembly Houses",{"href":"/en/products/quick-assembly","children":["Quick Assembly Houses",["$","b",null,{"children":"→"}]]}],["$","a","Site Camp Planning Checklist",{"href":"/en/news/site-camp-planning-checklist","children":["Site Camp Planning Checklist",["$","b",null,{"children":"→"}]]}]]}]]}],["$