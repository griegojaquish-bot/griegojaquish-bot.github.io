1:["$","main",null,{"className":"article enArticle","children":[["$","header",null,{"className":"detailTop","children":[["$","$L6",null,{"className":"brand","href":"/en","children":[["$","b",null,{"children":"ZY"}],["$","span",null,{"children":["SHANJIANG",["$","small",null,{"children":"MODULAR HOUSING"}]]}]]}],["$","div",null,{"children":[["$","$L6",null,{"href":"/en/news","children":"Back to news"}],["$","a",null,{"className":"detailCta","href":"/en/#contact","children":"Get a quote →"}]]}]]}],["$","section",null,{"className":"articleHero","children":[["$","small",null,{"children":["Delivery Guide","　·　","Jul 15, 2026"]}],["$","h1",null,{"children":"What Should You Confirm Before Planning a Site Camp?"}],["$","p",null,{"children":"A useful site camp is not defined by the number of units alone. Offices, accommodation, welfare, logistics and pedestrian-vehicle movement should be planned together from the beginning."}]]}],["$","div",null,{"className":"articleBody","children":[["$","aside",null,{"children":[["$","span",null,{"children":"CONTENTS"}],[["$","a","Start with four basic inputs",{"href":"#section-1","children":["0",1,"　","Start with four basic inputs"]}],["$","a","Separate the functional zones",{"href":"#section-2","children":["0",2,"　","Separate the functional zones"]}],["$","a","Do not overlook the services",{"href":"#section-3","children":["0",3,"　","Do not overlook the services"]}]]]}],["$","article",null,{"children":[[["$","section","Start with four basic inputs",{"id":"section-1","children":[["$","h2",null,{"children":"Start with four basic inputs"}],[["$","p","The location affects transport, climate requirements and site organisation. Occupancy determines offices, bedrooms and sanitary facilities. The schedule shapes the temporary-building approach, while the budget helps select the right product system.",{"children":"The location affects transport, climate requirements and site organisation. Occupancy determines offices, bedrooms and sanitary facilities. The schedule shapes the temporary-building approach, while the budget helps select the right product system."}],["$","p","The clearer these inputs are, the closer the layout and quotation will be to the final deliverable solution.",{"children":"The clearer these inputs are, the closer the layout and quotation will be to the final deliverable solution."}]]]}],["$","section","Separate the functional zones",{"id":"section-2","children":[["$","h2",null,{"children":"Separate the functional zones"}],[["$","p","Arrange project offices, meeting and reception areas, accommodation, catering, welfare and material storage with clear relationships. Keep fire routes and future expansion space available.",{"children":"Arrange project offices, meeting and reception areas, accommodation, catering, welfare and material storage with clear relationships. Keep fire routes and future expansion space available."}],["$","p","For projects with changing headcount, phased modular expansion can avoid over-investment at the beginning.",{"children":"For projects with changing headcount, phased modular expansion can avoid over-investment at the beginning."}]]]}],["$","section","Do not overlook the services",{"id":"section-3","children":[["$","h2",null,{"children":"Do not overlook the services"}],[["$","p","Water supply, drainage, electrical capacity, lighting, air conditioning, network, fencing and access control should be considered before installation. The camp works best when the building and its services are planned together.",{"children":"Water supply, drainage, electrical capacity, lighting, air conditioning, network, fencing and access control should be considered before installation. The camp works best when the building and its services are planned together."}]]]}]],["$","div",null,{"className":"articleCallout","children":["$L7","$L8","$L9"]}]]}]]}],"$La","$Lb"]}]
